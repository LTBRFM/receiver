        "payload": {
          "v": 1,
          "s": 412,
          "p": 8123456.4,
          "t": 1756470000123,
          "dp": {
            "id": "dp-1",
            "n": "Afternoon Drive",
            "sh": "The Drive Home",
            "dj": "Nia"
          },
          "now": {
            "k": "track",
            "i": "0bed7091-1111-4222-8333-444455556666",
            "a": "The Tower Block Collective",
            "ti": "Concrete Sunrise",
            "st": 8100000,
            "du": 214000
          },
          "q": [
            {
              "k": "track",
              "i": "t2",
              "a": "Artist Two",
              "ti": "Second Song",
              "st": 8314000,
              "du": 198000
